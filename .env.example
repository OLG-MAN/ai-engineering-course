# Copy to .env and fill in. .env is git-ignored.

# OpenAI-compatible endpoint used by lesson labs (lessons/common/llm.py).
# Default: Gemini API free tier with an AI Studio key.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it
# minimal for Gemma 4 on the Gemini API, none for gemini-*-flash, empty for local MLX
LLM_REASONING_EFFORT=minimal
# seconds to pause after each call (free-tier rate limits)
LLM_PAUSE_S=1
# Local MLX instead (p07 labs): LLM_BASE_URL=http://host.docker.internal:8080/v1  LLM_MODEL=mlx-community/gemma-4-e4b-it-4bit  LLM_REASONING_EFFORT=

# Direct vendor APIs (only for lessons that are explicitly vendor-specific)
ANTHROPIC_API_KEY=

# GCP track. Auth is ADC (gcloud auth application-default login), never a key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Makes the google-genai SDK use Vertex AI instead of the Gemini Developer API (enable at G1)
# GOOGLE_GENAI_USE_VERTEXAI=true

# Self-hosted observability and vector DB for local runs
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
