# Copy to .env and fill in. .env is git-ignored.

# OpenAI-compatible endpoint used by lesson code: hosted provider, vLLM, Ollama (http://localhost:11434/v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Direct vendor APIs (only for lessons that are explicitly vendor-specific)
ANTHROPIC_API_KEY=

# GCP track. Auth is ADC (gcloud auth application-default login), never a key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Makes the google-genai SDK use Vertex AI instead of the Gemini Developer API
GOOGLE_GENAI_USE_VERTEXAI=true

# Self-hosted observability and vector DB for local runs
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
